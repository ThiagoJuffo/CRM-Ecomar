# ---------------------------------------------------------------------------
# Configuracao do CRM da Ecomar (Frappe CRM via Docker)
# Copie este arquivo para ".env" e ajuste os valores conforme necessario:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Nome do site (dominio local de acesso). Precisa terminar em .localhost
# para funcionar automaticamente no navegador em ambiente de desenvolvimento.
SITE_NAME=crm.localhost

# Senha do usuario root do MariaDB (banco de dados).
# Troque em qualquer ambiente que nao seja puramente local.
DB_ROOT_PASSWORD=123

# Senha do usuario Administrator do CRM (login inicial).
ADMIN_PASSWORD=admin

# Portas expostas na sua maquina.
# Acesse o CRM em http://localhost:8000 (ou a porta que definir aqui).
WEB_PORT=8000
SOCKETIO_PORT=9000

# Branches usadas na build (avancado - normalmente nao precisa mexer).
CRM_BRANCH=main
FRAPPE_BRANCH=version-15
